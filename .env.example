# Web 前端本机访问端口；Compose 仅绑定 127.0.0.1，不会直接暴露到局域网。
WEB_PORT=3000
# API 本机访问端口；修改后前端 API 文档链接也会使用此端口。
API_PORT=8000
# 后端日志级别，可选 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO

# MySQL 初始化时创建的业务数据库名称和应用连接账户。
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
# 应用账户密码和 MySQL 管理员密码；运行 scripts/init-env.ps1 自动生成随机值。
# .env 含本机凭据且已加入 Git 忽略规则，禁止把真实值提交到仓库。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
# 访问令牌签名密钥由初始化脚本随机生成；不要与其他密钥共用或提交真实值。
AUTH_SECRET_KEY=
# 访问令牌有效期，单位为分钟。
AUTH_TOKEN_EXPIRE_MINUTES=60

# M3 模型配置：密钥只在本机 .env 中填写，保存后重建服务才会进入容器。
# 文本/图片共用 OpenAI 官方 API 密钥；连接检查仅请求模型元数据，不生成内容。
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
# 图片模型标识；图片生成能力仍需后续阶段与账号权限单独验收。
OPENAI_IMAGE_MODEL=
# 视频供应商可选 jimeng 或 dashscope，使用独立密钥；M3 暂不执行视频生成连接调用。
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_MODEL=
