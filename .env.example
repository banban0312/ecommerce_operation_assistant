# Local ports; containers are only published on the loopback interface.
WEB_PORT=3000
API_PORT=8000
LOG_LEVEL=INFO

MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
# Run scripts/init-env.ps1 to generate local passwords. Do not commit .env.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# Reserved for later issues. The foundation does not call model providers.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_MODEL=
