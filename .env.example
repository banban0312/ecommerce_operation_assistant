# 本机访问端口；容器服务仅绑定到本机回环地址。
WEB_PORT=3000
API_PORT=8000
LOG_LEVEL=INFO

MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce
# 运行 scripts/init-env.ps1 生成随机本地密码；真实 .env 不要提交到 Git。
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# 为后续模型功能预留；当前工程基线不会调用模型服务。
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=
OPENAI_IMAGE_MODEL=
VIDEO_PROVIDER=
VIDEO_API_KEY=
VIDEO_MODEL=
